{
  "name": "@wesdizzle/app-kit",
  "version": "1.0.0",
  "description": "Shared Cloudflare Worker OIDC/session infrastructure, D1 cost-guard & operational CLI scripts, semantic CSS tokens, and Angular shell components.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./scripts": {
      "types": "./dist/scripts/index.d.ts",
      "default": "./dist/scripts/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.worker-scripts.json && ngc -p tsconfig.angular.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "ci-check": "npm run type-check && npm test && npm run build"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@cloudflare/workers-types": "^4.20260305.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
