{
  "name": "@wesdizzle/app-kit",
  "version": "1.2.0",
  "description": "Shared Cloudflare Worker OIDC/session/WebAuthn/WebPush/R2-backup infrastructure, D1 cost-guard & schema-diff CLI scripts, semantic M3 Expressive CSS tokens, and Angular 21 shell components.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./scripts": {
      "types": "./dist/scripts/index.d.ts",
      "default": "./dist/scripts/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./styles/tokens.css": "./styles/tokens.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.worker-scripts.json && ngc -p tsconfig.angular.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "ci-check": "npm run lint && npm run format:check && npm run type-check && npm test && npm run build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@cloudflare/workers-types": "^4.20260305.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "eslint": "^10.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
